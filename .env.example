# Masukkan API Key DeepSeek kamu di sini
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Konfigurasi Bahasa & Suara Edge-TTS
# Bahasa Indonesia: id-ID-ArdiNeural (Pria) atau id-ID-GadisNeural (Wanita)
# Bahasa Inggris: en-US-ChristopherNeural atau en-US-GuyNeural
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+10%

# Resolusi & FPS Video Shorts (9:16)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24
